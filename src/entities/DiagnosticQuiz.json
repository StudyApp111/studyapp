{
  "name": "DiagnosticQuiz",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Associated lesson ID"
    },
    "smart_summary": {
      "type": "object",
      "description": "Smart summary of curriculum with rich text",
      "properties": {
        "title": {
          "type": "string"
        },
        "content_markdown": {
          "type": "string"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_type": {
            "type": "string"
          },
          "difficulty_index": {
            "type": "string"
          },
          "targeted_misconception": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          }
        }
      },
      "description": "5 diagnostic quiz questions"
    },
    "user_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User's selected answers"
    },
    "score": {
      "type": "number",
      "description": "Quiz score percentage"
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "lesson_id"
  ]
}