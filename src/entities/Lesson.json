{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "course_name": {
      "type": "string",
      "description": "Name of the course"
    },
    "description": {
      "type": "string",
      "description": "Lesson description"
    },
    "url": {
      "type": "string",
      "description": "External resource URL"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "description",
        "url",
        "file"
      ],
      "description": "Type of lesson input"
    },
    "curriculum_map": {
      "type": "object",
      "description": "AI-generated comprehensive curriculum profile",
      "properties": {
        "core_competencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "competency_weightings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "competency_name": {
                "type": "string"
              },
              "weight_percentage": {
                "type": "string"
              }
            }
          }
        },
        "question_formats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "frequency": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "high_yield_focal_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "common_misconceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "diagnostic_completed",
        "worksheet_completed",
        "completed"
      ],
      "default": "created"
    }
  },
  "required": [
    "course_name"
  ]
}