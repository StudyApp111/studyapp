{
  "name": "Worksheet",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Associated lesson ID"
    },
    "diagnostic_quiz_id": {
      "type": "string",
      "description": "Associated diagnostic quiz ID"
    },
    "analysis_summary": {
      "type": "object",
      "description": "AI analysis of student's weak areas and targeted competencies",
      "properties": {
        "targeted_weak_competencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_gaps_or_misconceptions_addressed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focused_differentiating_competencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "answer_key": {
      "type": "array",
      "description": "Detailed answer key with explanations",
      "items": {
        "type": "object",
        "properties": {
          "correct_answer": {
            "type": "string"
          },
          "detailed_explanation": {
            "type": "string"
          },
          "linked_competency_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targeted_misconception_or_predicted_errors": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "true_false",
              "short_answer",
              "long_answer"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "points": {
            "type": "number"
          }
        }
      },
      "description": "Generated worksheet questions"
    },
    "user_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User's answers"
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_index": {
            "type": "integer"
          },
          "is_correct": {
            "type": "boolean"
          },
          "feedback": {
            "type": "string"
          },
          "points_earned": {
            "type": "number"
          }
        }
      }
    },
    "predicted_grade": {
      "type": "string",
      "description": "AI-predicted grade"
    },
    "total_score": {
      "type": "number"
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "lesson_id"
  ]
}