{
  "name": "Exam",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Associated lesson ID"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "official",
        "practice"
      ],
      "default": "official",
      "description": "Official exams have grade prediction, practice exams are quick drills"
    },
    "exam_number": {
      "type": "integer",
      "description": "Exam number (1-6 for official)",
      "default": 1
    },
    "title": {
      "type": "string",
      "description": "Display title for the exam"
    },
    "study_plan_id": {
      "type": "string",
      "description": "Associated study plan (for practice exams)"
    },
    "focus_competency": {
      "type": "string",
      "description": "Target competency for practice exams"
    },
    "focus_description": {
      "type": "string",
      "description": "Description of what this exam focuses on"
    },
    "time_taken_seconds": {
      "type": "number",
      "description": "Total time taken to complete this exam in seconds",
      "default": 0
    },
    "question_time_laps": {
      "type": "array",
      "description": "Time spent on each question",
      "items": {
        "type": "object",
        "properties": {
          "question_index": {
            "type": "integer"
          },
          "total_seconds": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "questions": {
      "type": "array",
      "description": "Exam questions",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_type": {
            "type": "string"
          },
          "difficulty_index": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user_answer": {
            "type": "string"
          },
          "correct_answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "assessed_competencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targeted_misconception": {
            "type": "string"
          },
          "is_correct": {
            "type": "boolean"
          },
          "ai_score_out_of_10": {
            "type": "number"
          },
          "ai_verdict": {
            "type": "string"
          },
          "ai_rationale_short": {
            "type": "string"
          },
          "ai_keypoints_hit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ai_keypoints_missed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ai_misconception_detected": {
            "type": "boolean"
          },
          "ai_grading_pending": {
            "type": "boolean"
          }
        }
      }
    },
    "feedback": {
      "type": "array",
      "description": "Per-question feedback",
      "items": {
        "type": "object",
        "properties": {
          "question_index": {
            "type": "integer"
          },
          "is_correct": {
            "type": "boolean"
          },
          "feedback": {
            "type": "string"
          },
          "points_earned": {
            "type": "number"
          }
        }
      }
    },
    "ai_feedback": {
      "type": "object",
      "description": "AI feedback (official exams only)",
      "properties": {
        "feedback_session_title": {
          "type": "string"
        },
        "predicted_exam_score_percentage": {
          "type": "string"
        },
        "prediction_confidence_percentage": {
          "type": "number"
        },
        "confidence_level": {
          "type": "string"
        },
        "mastery_gap": {
          "type": "string"
        },
        "mastery_gap_description": {
          "type": "string"
        },
        "prediction_calculation_rationale": {
          "type": "string"
        },
        "overall_performance_summary_text": {
          "type": "string"
        },
        "identified_strengths_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_areas_for_improvement_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_future_sessions_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "session_number": {
                "type": "integer"
              },
              "session_name": {
                "type": "string"
              },
              "session_focus_description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "predicted_grade": {
      "type": "string",
      "description": "Letter grade (official exams only)"
    },
    "prediction_confidence": {
      "type": "number",
      "description": "Confidence percentage of the grade prediction (0-100)"
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "Medium-High",
        "High"
      ],
      "description": "Categorical confidence level"
    },
    "mastery_gap": {
      "type": "string",
      "description": "The single weakest competency identified"
    },
    "total_score": {
      "type": "number",
      "description": "Score percentage"
    },
    "correct_count": {
      "type": "integer",
      "description": "Number of correct answers (for practice exams)"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "lesson_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": [
      {
        "created_by": "{{user.email}}"
      },
      {
        "user_condition": {
          "role": "admin"
        }
      }
    ],
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}