{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person submitting feedback"
    },
    "email": {
      "type": "string",
      "description": "Email of the person submitting feedback"
    },
    "message": {
      "type": "string",
      "description": "Feedback message"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved"
      ],
      "default": "new",
      "description": "Status of the feedback"
    }
  },
  "required": [
    "email",
    "message"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}