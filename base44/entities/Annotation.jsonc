{
  "name": "Annotation",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Associated lesson ID"
    },
    "highlight_text": {
      "type": "string",
      "description": "The highlighted text"
    },
    "note": {
      "type": "string",
      "description": "User's note for this highlight"
    },
    "position": {
      "type": "object",
      "description": "Position information for the highlight",
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "yellow",
        "green",
        "blue",
        "pink",
        "purple"
      ],
      "default": "yellow",
      "description": "Highlight color"
    }
  },
  "required": [
    "lesson_id",
    "highlight_text"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}