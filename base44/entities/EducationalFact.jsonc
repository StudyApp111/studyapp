{
  "name": "EducationalFact",
  "type": "object",
  "properties": {
    "fact_text": {
      "type": "string",
      "description": "The fun fact text"
    },
    "category": {
      "type": "string",
      "description": "Category of the fact (Science, History, Math, etc.)"
    },
    "icon": {
      "type": "string",
      "description": "Emoji icon for the fact"
    }
  },
  "required": [
    "fact_text",
    "category"
  ]
}