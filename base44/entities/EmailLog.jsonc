{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "email_template_id": {
      "type": "string",
      "description": "AutomaticEmail template ID"
    },
    "trigger_type": {
      "type": "string",
      "description": "What triggered this email"
    },
    "trigger_reference_id": {
      "type": "string",
      "description": "Reference ID (worksheet_id, assignment_id, etc.)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the email was sent"
    },
    "success": {
      "type": "boolean",
      "description": "Whether email was sent successfully"
    }
  },
  "required": [
    "user_email",
    "trigger_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}