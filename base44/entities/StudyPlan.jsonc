{
  "name": "StudyPlan",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "Associated lesson ID"
    },
    "generated_from_exam_id": {
      "type": "string",
      "description": "The official exam that generated this plan"
    },
    "cycle_number": {
      "type": "integer",
      "description": "Which improvement cycle (1, 2, 3...)",
      "default": 1
    },
    "initial_predicted_grade": {
      "type": "string",
      "description": "Grade when plan was generated"
    },
    "initial_score": {
      "type": "number",
      "description": "Score % when plan was generated"
    },
    "initial_confidence": {
      "type": "number",
      "description": "Prediction confidence % when plan was generated"
    },
    "current_predicted_grade": {
      "type": "string",
      "description": "Current predicted grade from Polly engine"
    },
    "current_score": {
      "type": "number",
      "description": "Current score % from Polly engine"
    },
    "current_confidence": {
      "type": "number",
      "description": "Current confidence from Polly engine"
    },
    "learning_velocity": {
      "type": "string",
      "enum": [
        "Accelerating",
        "Stagnating",
        "Declining"
      ],
      "description": "Learning velocity from Polly engine"
    },
    "mastery_gap": {
      "type": "string",
      "description": "The single weakest competency to focus on"
    },
    "target_grade": {
      "type": "string",
      "description": "Target grade (usually A+)",
      "default": "A+"
    },
    "weak_competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies to focus on"
    },
    "suggested_tasks": {
      "type": "array",
      "description": "AI-suggested study tasks for dynamic task generation",
      "items": {
        "type": "object",
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "flashcards",
              "teach_it",
              "review_notes",
              "practice_exam"
            ]
          },
          "topic_name": {
            "type": "string"
          },
          "section_title": {
            "type": "string"
          },
          "task_description": {
            "type": "string"
          },
          "task_reason": {
            "type": "string"
          }
        }
      }
    },
    "behavioral_insights": {
      "type": "object",
      "description": "AI behavioral analysis from Polly engine",
      "properties": {
        "is_guessing_detected": {
          "type": "boolean"
        },
        "is_inefficient_studying": {
          "type": "boolean"
        },
        "recommended_focus": {
          "type": "string"
        },
        "estimated_hours_to_target": {
          "type": "number"
        }
      }
    },
    "insights_panel": {
      "type": "object",
      "description": "AI-generated insights panel from generateStudyPlan",
      "properties": {
        "headline": {
          "type": "string"
        },
        "support_text": {
          "type": "string"
        },
        "pills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Study tasks to complete",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "flashcards",
              "teach_it",
              "review_notes",
              "practice_exam"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target_count": {
            "type": "integer"
          },
          "completed_count": {
            "type": "integer",
            "default": 0
          },
          "target_competency": {
            "type": "string"
          },
          "focus_topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific topics to focus on for targeted content generation"
          },
          "misconception_addressed": {
            "type": "string",
            "description": "The misconception this task addresses"
          },
          "is_focus_factor": {
            "type": "boolean",
            "default": false,
            "description": "True if this task directly targets the mastery_gap"
          },
          "is_custom": {
            "type": "boolean",
            "default": false,
            "description": "True if this task was created by the user"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "completed_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "competency_progress": {
      "type": "array",
      "description": "Progress per competency",
      "items": {
        "type": "object",
        "properties": {
          "competency_name": {
            "type": "string"
          },
          "initial_score": {
            "type": "number"
          },
          "current_score": {
            "type": "number"
          },
          "questions_attempted": {
            "type": "integer",
            "default": 0
          },
          "questions_correct": {
            "type": "integer",
            "default": 0
          }
        }
      }
    },
    "grade_history": {
      "type": "array",
      "description": "Track predicted grade over time",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "exam_id": {
            "type": "string"
          },
          "predicted_grade": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "plan_rationale": {
      "type": "string",
      "description": "AI explanation of why this plan was designed"
    },
    "priority_focus": {
      "type": "string",
      "description": "The single most important thing to improve"
    },
    "all_tasks_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether all tasks are done"
    },
    "official_exam_unlocked": {
      "type": "boolean",
      "default": false,
      "description": "Whether next official exam is ready"
    },
    "last_polly_update": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last Polly engine update"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "superseded"
      ],
      "default": "active"
    }
  },
  "required": [
    "lesson_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": [
      {
        "created_by": "{{user.email}}"
      },
      {
        "user_condition": {
          "role": "admin"
        }
      }
    ],
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}