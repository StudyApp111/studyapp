{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The promo code (stored as hash, never plain text)"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 hash of the code for secure lookup"
    },
    "type": {
      "type": "string",
      "enum": [
        "free_access",
        "discount_percent",
        "discount_fixed"
      ],
      "description": "Type of promo: free access, percentage discount, or fixed amount off"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount amount (percent for discount_percent, dollars for discount_fixed)"
    },
    "duration_days": {
      "type": "integer",
      "description": "How many days the promo lasts (for free_access type)"
    },
    "max_uses": {
      "type": "integer",
      "default": 1,
      "description": "Maximum number of times this code can be used (1 = single use)"
    },
    "current_uses": {
      "type": "integer",
      "default": 0,
      "description": "Current number of times code has been used"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the code is still valid"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code itself expires (different from duration)"
    },
    "created_by_admin": {
      "type": "string",
      "description": "Admin email who created the code"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the code"
    }
  },
  "required": [
    "code_hash",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}