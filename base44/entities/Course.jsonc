{
  "name": "Course",
  "type": "object",
  "properties": {
    "course_code": {
      "type": "string",
      "description": "e.g., GRST 211 L01"
    },
    "full_name": {
      "type": "string",
      "description": "Full descriptive name of the course"
    },
    "description": {
      "type": "string",
      "description": "Course description"
    },
    "subject_category": {
      "type": "string",
      "enum": [
        "Written & Interpretive Subjects (Humanities / Social Sciences)",
        "Problem-Solving & Conceptual Subjects (Math / Physics / Engineering)",
        "Applied & Empirical Subjects (Biology / Chemistry / Earth Sciences / Health Sciences)",
        "Computational & Logical Subjects (Computer Science / Programming / Data Structures)",
        "Quantitative Applied Subjects (Statistics / Economics / Finance / Business Analytics)"
      ],
      "description": "The classified subject category of the course"
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of learning outcomes"
    },
    "learning_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Textbooks, websites, or other resources"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "assignment",
              "quiz",
              "exam",
              "project",
              "other"
            ]
          },
          "due_date": {
            "type": "string"
          },
          "weight": {
            "type": "string",
            "description": "Percentage weight e.g. '20%'"
          }
        }
      },
      "description": "Assignments, quizzes, and exams"
    },
    "required_readings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Chapters, articles, or specific readings"
    },
    "grading_scale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string",
            "description": "e.g. A+"
          },
          "min_score": {
            "type": "number",
            "description": "e.g. 95"
          },
          "max_score": {
            "type": "number",
            "description": "e.g. 100"
          }
        }
      },
      "description": "Grading system breakdown"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded course outline"
    },
    "learning_style_answers": {
      "type": "object",
      "description": "User answers to the baseline learning style questions"
    },
    "status": {
      "type": "string",
      "enum": [
        "mapped",
        "questions_pending",
        "active"
      ],
      "default": "mapped"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}