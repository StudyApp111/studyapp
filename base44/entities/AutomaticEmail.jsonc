{
  "name": "AutomaticEmail",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this email trigger"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "signup",
        "onboarding_completed",
        "signup_no_onboarding_4h",
        "signup_no_lesson_24h",
        "first_lesson_created",
        "first_diagnostic_completed",
        "lesson_no_diagnostic_24h",
        "first_studyplan_generated",
        "diagnostic_no_studyplan_48h",
        "first_worksheet_completed",
        "first_assignment_graded",
        "lesson_all_worksheets_completed",
        "inactive_3_days",
        "inactive_7_days",
        "inactive_14_days",
        "inactive_30_days"
      ],
      "description": "What in-app action or delayed condition triggers this email"
    },
    "resend_template_id": {
      "type": "string",
      "description": "Resend template ID to use (optional if subject+body provided)"
    },
    "resend_template_name": {
      "type": "string",
      "description": "Resend template name for display"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line (supports {{variable}} placeholders). Used when sending without a Resend template."
    },
    "body": {
      "type": "string",
      "description": "Email HTML body (supports {{variable}} placeholders). Used when sending without a Resend template."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this trigger is active"
    },
    "send_count": {
      "type": "number",
      "default": 0,
      "description": "Total emails sent via this trigger"
    },
    "trigger_config": {
      "type": "object",
      "description": "Additional config for delayed triggers",
      "properties": {
        "delay_hours": {
          "type": "number",
          "description": "Delay in hours before sending (for time-delayed triggers)"
        }
      }
    }
  },
  "required": [
    "name",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}