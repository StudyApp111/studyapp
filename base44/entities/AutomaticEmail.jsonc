{
  "name": "AutomaticEmail",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this email trigger"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "signup",
        "onboarding_completed",
        "first_lesson_created",
        "first_diagnostic_completed",
        "first_studyplan_generated",
        "first_worksheet_completed",
        "first_assignment_graded",
        "lesson_all_worksheets_completed",
        "signup_no_lesson_4h",
        "lesson_no_diagnostic_24h",
        "quiz_no_return_24h",
        "session_no_followup_24h",
        "upgrade_momentum",
        "trial_expiring",
        "inactive_3_days",
        "inactive_7_days",
        "inactive_14_days",
        "inactive_30_days",
        "desktop_link_request"
      ],
      "description": "What in-app action or delayed condition triggers this email"
    },
    "resend_template_id": {
      "type": "string",
      "description": "Resend template ID to use (optional if subject+body provided)"
    },
    "resend_template_name": {
      "type": "string",
      "description": "Resend template name for display"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line (supports {{variable}} placeholders). Used when sending without a Resend template."
    },
    "body": {
      "type": "string",
      "description": "Email HTML body (supports {{variable}} placeholders). Used when sending without a Resend template."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this trigger is active"
    },
    "send_count": {
      "type": "number",
      "default": 0,
      "description": "Total emails sent via this trigger"
    },
    "trigger_config": {
      "type": "object",
      "description": "Additional config for delayed/conditional triggers",
      "properties": {
        "delay_hours": {
          "type": "number",
          "description": "Delay in hours before sending (for time-delayed triggers)"
        },
        "condition_field": {
          "type": "string",
          "description": "User field to check (e.g. questions_completed, current_streak)"
        },
        "condition_operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte",
            "eq"
          ],
          "description": "Comparison operator"
        },
        "condition_value": {
          "type": "number",
          "description": "Threshold value"
        },
        "plan_filter": {
          "type": "string",
          "enum": [
            "free",
            "pro_trial",
            "pro",
            "any"
          ],
          "description": "Only fire for users on this plan type"
        }
      }
    }
  },
  "required": [
    "name",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}