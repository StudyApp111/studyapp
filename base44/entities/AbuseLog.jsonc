{
  "name": "AbuseLog",
  "type": "object",
  "properties": {
    "ip_address": {
      "type": "string",
      "description": "Hashed IP address for privacy"
    },
    "fingerprint": {
      "type": "string",
      "description": "Browser fingerprint hash"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "ocr_upload",
        "diagnostic_exam",
        "report_view"
      ],
      "description": "Type of action attempted"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent"
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "Whether this request was blocked"
    },
    "blocked_reason": {
      "type": "string",
      "description": "Why request was blocked (rate_limit_ip, rate_limit_fingerprint, honeypot, combined_abuse)"
    },
    "honeypot_triggered": {
      "type": "boolean",
      "default": false,
      "description": "Bot detected via honeypot"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (file size, exam ID, etc.)"
    }
  },
  "required": [
    "ip_address",
    "fingerprint",
    "action_type"
  ]
}